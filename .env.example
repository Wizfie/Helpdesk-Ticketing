# ==============================================================================
# Root Environment Configuration - Glotra ServiceDesk (Docker Compose / VPS)
# Salin berkas ini menjadi .env di VPS: cp .env.example .env
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=production

# Database Configuration
# (Saat memakai Docker Compose, DATABASE_URL otomatis diarahkan ke container db)
DATABASE_URL="mysql://root:@localhost:3306/db_helpdesk_glotra"
DB_ROOT_PASSWORD=root_glotra_pass_2026
DB_NAME=helpdesk_glotra
DB_USER=glotra_user
DB_PASSWORD=glotra_password_2026

# JWT Token Secret (Wajib ganti di VPS produksi)
JWT_SECRET="glotra_jwt_secret_production_2026"
JWT_EXPIRES_IN="7d"

# Storage & Upload Guard
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15
ALLOWED_MIME_TYPES="application/pdf,image/png,image/jpeg,image/svg+xml,text/plain"

# Path Disk Host VPS (Aktifkan pada .env VPS agar data tetap aman walau rebuild/down -v)
# MYSQL_STORAGE_PATH="/srv/glotra-helpdesk/mysql"
# UPLOAD_STORAGE_PATH="/srv/glotra-helpdesk/uploads"

# Frontend Public URL (Untuk link tracking di email notifikasi — ganti ke IP/Domain VPS)
CLIENT_URL="http://localhost:5173"

# Auto-seed aman saat start pertama (hanya mengisi jika tabel users masih kosong)
SEED_ON_START=auto

# Email Gateway Configuration (Default: Resend - Gratis 3.000 email/bulan)
EMAIL_PLATFORM="resend"
EMAIL_FROM_NAME="Glotra ServiceDesk (No-Reply)"
EMAIL_FROM_ADDRESS="onboarding@resend.dev"
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="resend"
SMTP_PASS="re_isi_api_key_resend_anda"
