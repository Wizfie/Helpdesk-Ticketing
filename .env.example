# ==============================================================================
# Root Environment Configuration - PT Glotra Helpdesk Ticketing (Docker Compose / Production)
# Salin berkas ini menjadi .env jika ingin mengganti kredensial (cp .env.example .env)
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=production

# Database Configuration
DATABASE_URL="mysql://root:@localhost:3306/db_helpdesk_glotra"
DB_ROOT_PASSWORD=root
DB_NAME=db_helpdesk_glotra
DB_USER=root
DB_PASSWORD=

# JWT Token Secret
JWT_SECRET="glotra_jwt_secret_production_2026"
JWT_EXPIRES_IN="7d"

# Storage & Upload Guard
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15
ALLOWED_MIME_TYPES="application/pdf,image/png,image/jpeg,image/svg+xml,text/plain"

# Frontend & CORS URL (Ganti dengan domain publik di VPS)
CLIENT_URL="http://localhost:5173"

# Seed on start
SEED_ON_START=false

# Universal SMTP Email Gateway Configuration
EMAIL_FROM_NAME="PT Global Transformasi Teknologi (No-Reply)"
EMAIL_FROM_ADDRESS="noreply@gtteknologi.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@gtteknologi.com"
SMTP_PASS="password_atau_app_password_smtp"
