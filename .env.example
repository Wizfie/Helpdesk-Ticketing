# ==============================================================================
# Root Environment Configuration - PT Glotra Helpdesk Ticketing (Docker Compose)
# Salin berkas ini menjadi .env jika ingin mengganti kredensial (cp .env.example .env)
# ==============================================================================

# Port Layanan Eksternal
PORT=5000
NODE_ENV=production

# Kredensial Database MySQL di Kontainer
DB_ROOT_PASSWORD=root
DB_NAME=db_helpdesk_glotra
DB_USER=root
DB_PASSWORD=

# Kunci JWT Token Autentikasi (Ganti dengan string rahasia yang kuat)
JWT_SECRET=glotra_jwt_secret_production_2026

# Otomatis Seed Data Awal saat kontainer pertama kali dijalankan (true/false)
SEED_ON_START=false
