# ==============================================================================
# Frontend Environment Configuration - PT Glotra Helpdesk Ticketing
# Salin berkas ini menjadi .env jika ingin mengubah konfigurasi (cp .env.example .env)
# ==============================================================================

# URL Basis REST API Backend
# - Untuk Mode Nginx / Docker (Default): gunakan '/api' (otomatis di-reverse proxy oleh Nginx)
# - Untuk Mode Dev Lokal tanpa Nginx: gunakan 'http://localhost:5000/api'
VITE_API_URL="/api"

# Pengaturan Port Vite Dev Server (Opsional)
# VITE_PORT=5173
