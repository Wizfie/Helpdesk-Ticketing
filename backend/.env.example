# ==============================================================================
# Backend Environment Configuration - PT Glotra Helpdesk Ticketing
# Salin berkas ini menjadi .env sebelum menjalankan server (cp .env.example .env)
# ==============================================================================

# Konfigurasi Server Express
PORT=5000
NODE_ENV=development

# Koneksi Database MySQL (Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME)
# Contoh lokal (Laragon/XAMPP): mysql://root:@localhost:3306/db_helpdesk_glotra
# Contoh VPS/Docker: mysql://glotra_user:password_rahasia@localhost:3306/db_helpdesk_glotra
DATABASE_URL="mysql://root:@localhost:3306/db_helpdesk_glotra"

# Keamanan & JWT Token
JWT_SECRET="ganti_dengan_kunci_rahasia_acak_yang_panjang_dan_kuat_2026"
JWT_EXPIRES_IN="7d"

# Konfigurasi Upload Berkas & Bukti Digital
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15
ALLOWED_MIME_TYPES="application/pdf,image/png,image/jpeg,image/svg+xml,text/plain"

# URL Frontend untuk CORS & Tautan Email Tracking Mandiri
# Di VPS Produksi ganti dengan domain resmi, contoh: https://helpdesk.gtteknologi.com
CLIENT_URL="http://localhost:5173"

# Seeding otomatis (true jika ingin mengisi data awal saat database baru di-deploy)
SEED_ON_START=false

# Konfigurasi Gateway Email (Universal SMTP)
# Bekerja untuk semua penyedia: Sumopod, SendGrid, Gmail, Mailgun, Zimbra, dsb.
EMAIL_FROM_NAME="PT Global Transformasi Teknologi (No-Reply)"
EMAIL_FROM_ADDRESS="noreply@gtteknologi.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@gtteknologi.com"
SMTP_PASS="password_atau_app_password_smtp"
