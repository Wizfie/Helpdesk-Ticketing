{
  "name": "ticketing-helpdesk-gtt",
  "version": "1.0.0",
  "description": "ITSM Enterprise Helpdesk & SLA Ticketing System - PT Global Transformasi Teknologi",
  "scripts": {
    "tunnel": "cloudflared tunnel --url http://localhost:5176",
    "tunnel:backend": "cloudflared tunnel --url http://localhost:5000",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "docker:up": "docker compose up -d --build",
    "docker:up:frontend": "docker compose up -d --no-deps --build frontend",
    "docker:up:backend": "docker compose up -d --no-deps --build backend",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "helpdesk",
    "ticketing",
    "itsm",
    "vue",
    "express",
    "prisma",
    "mysql",
    "cloudflare"
  ],
  "author": "Mahasiswa KP Unpam",
  "license": "ISC"
}